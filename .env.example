# OpenAI-compatible provider; AvalAI works with this URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_MODEL=gpt-4.1-mini
# Optional alternatives: METIS_API_KEY, METIS_BASE_URL, METIS_CHAT_MODEL
LLM_TIMEOUT_SECONDS=60
# Reads the image only; the existing tutor model still solves the transcribed question.
VISION_MODEL=gpt-4.1-mini
